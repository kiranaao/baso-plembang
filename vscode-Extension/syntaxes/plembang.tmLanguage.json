{
  "name": "Baso Plembang",
  "scopeName": "source.plg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.plg",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.plg",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#string_escape" }]
        },
        {
          "name": "string.quoted.triple.single.plg",
          "begin": "'''",
          "end": "'''",
          "patterns": [{ "include": "#string_escape" }]
        },
        {
          "name": "string.quoted.double.plg",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#string_escape" }]
        },
        {
          "name": "string.quoted.single.plg",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#string_escape" }]
        }
      ]
    },
    "string_escape": {
      "name": "constant.character.escape.plg",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|[\\\\\"'abfnrtv])"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fungsi|gawe)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.plg" },
            "2": { "name": "entity.name.function.plg" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.plg",
          "match": "\\b(kalu|kalu_bae|daknyo|selamo|tiap|didalem|berenti|lanjot|cubo|kalu_eror|akhernyo)\\b"
        },
        {
          "name": "keyword.control.flow.plg",
          "match": "\\b(balekke|metu)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.plg",
          "match": "\\b(toleske|masukke|banyak|urutan|angka|angko)\\b"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.plg" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.plg",
          "match": "\\b(iyo|dak|kosong)\\b"
        },
        {
          "name": "constant.numeric.float.plg",
          "match": "\\b[0-9]+\\.[0-9]+([eE][\\+\\-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.plg",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.plg",
          "match": "(\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\=)"
        },
        {
          "name": "keyword.operator.arithmetic.plg",
          "match": "(\\+|\\-|\\*\\*|\\*|\\/\\/|\\/|\\%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.plg",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.plg",
          "match": ":"
        },
        {
          "name": "punctuation.parenthesis.begin.plg",
          "match": "\\("
        },
        {
          "name": "punctuation.parenthesis.end.plg",
          "match": "\\)"
        },
        {
          "name": "punctuation.bracket.begin.plg",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket.end.plg",
          "match": "\\]"
        },
        {
          "name": "punctuation.brace.begin.plg",
          "match": "\\{"
        },
        {
          "name": "punctuation.brace.end.plg",
          "match": "\\}"
        }
      ]
    }
  }
}
